# Application
NEXT_PUBLIC_APP_NAME="FP Dashboard"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_OUT_FALLBACK_REDIRECT_URL="/sign-in"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fp_dashboard?schema=public"
# Prisma CLI and migration commands prefer this direct, non-pooler connection.
# In local development it may be the same URL as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fp_dashboard?schema=public"

# Rate limiting
# Optional production Redis limiter for Vercel/serverless deployments.
# If omitted, FP Dashboard uses the existing database ActionRateLimit table.
# The in-memory limiter is only a local/dev fallback and is not production-grade.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Supabase Storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_RESUME_BUCKET="student-resumes"

# Email notifications
RESEND_API_KEY=""
EMAIL_FROM="FP Dashboard <notifications@example.com>"
EMAIL_REPLY_TO=""
EMAIL_NOTIFICATIONS_ENABLED="false"

# OpenAI
OPENAI_API_KEY=""

# Scheduled jobs
CRON_SECRET=""

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
