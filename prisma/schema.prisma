model User {
  id                                   String                                   @id @default(cuid())
  clerkUserId                          String                                   @unique
  email                                String                                   @unique
  firstName                            String?
  lastName                             String?
  role                                 UserRole                                 @default(STUDENT)
  studentProfile                       StudentProfile?
  partnerMemberships                   PartnerMember[]
  placementRequestsRequested           PlacementRequest[]                       @relation("PlacementRequestRequester")
  placementRequestsAssigned            PlacementRequest[]                       @relation("PlacementRequestAssignee")
  outreachTasksAssigned                OutreachTask[]                           @relation("OutreachTaskAssignee")
  outreachTasksCreated                 OutreachTask[]                           @relation("OutreachTaskCreator")
  notifications                        Notification[]
  adminNotesAuthored                   AdminNote[]                              @relation("AdminNoteAuthor")
  adminNotesAbout                      AdminNote[]                              @relation("AdminNoteUser")
  auditLogs                            AuditLog[]                               @relation("AuditLogActor")
  recordComments                       RecordComment[]                          @relation("RecordCommentAuthor")
  onboardingItemsReviewed              ApplicationOnboardingItem[]              @relation("OnboardingItemReviewer")
  verifiedPartnerOrganizations         PartnerOrganization[]                    @relation("PartnerVerifier")
  moderatedOpportunities               Opportunity[]                            @relation("OpportunityModerator")
  verifiedOpportunities                Opportunity[]                            @relation("OpportunityVerifier")
  reviewedExternalOpportunityRequests  ExternalOpportunityVerificationRequest[] @relation("ExternalOpportunityVerificationReviewer")
  opportunityCorrectionReports         OpportunityCorrectionReport[]            @relation("OpportunityCorrectionReporter")
  reviewedOpportunityCorrectionReports OpportunityCorrectionReport[]            @relation("OpportunityCorrectionReviewer")
  claimedStudentImportRecords          StudentImportRecord[]                    @relation("StudentImportClaim")
  feedbackAuthored                     Feedback[]                               @relation("FeedbackAuthor")
  recommendationEvents                 RecommendationEvent[]                    @relation("RecommendationEventUser")
  dataQualityAcknowledgements          DataQualityAcknowledgement[]             @relation("DataQualityAcknowledgementUser")
  interviewRequestsCreated             InterviewRequest[]                       @relation("InterviewRequestCreator")
  interviewRequestsCanceled            InterviewRequest[]                       @relation("InterviewRequestCanceler")
  serviceHoursVerified                 ServiceHourRecord[]                      @relation("ServiceHourVerifier")
  certificatesApproved                 ServiceHourRecord[]                      @relation("CertificateApprover")
  programEventsCreated                 ProgramEvent[]                           @relation("ProgramEventCreator")
  eventRegistrationsCheckedIn          EventRegistration[]                      @relation("EventRegistrationCheckIn")
  sponsorInteractionsAuthored          SponsorInteraction[]                     @relation("SponsorInteractionAuthor")
  applicationActivities                ApplicationActivity[]                    @relation("ApplicationActivityActor")
  applicationOutcomeReportsModerated   ApplicationOutcomeReport[]               @relation("ApplicationOutcomeModerator")
  createdAt                            DateTime                                 @default(now())
  updatedAt                            DateTime                                 @updatedAt

  @@index([role])
  @@index([role, createdAt])
  @@index([createdAt])
}

model StudentProfile {
  id                                      String                                   @id @default(cuid())
  userId                                  String                                   @unique
  user                                    User                                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredName                           String?
  legalName                               String?
  phone                                   String?
  school                                  String?
  gradeYear                               String?
  major                                   String?
  graduationYear                          Int?
  city                                    String?
  state                                   String?
  country                                 String?
  locationPreference                      String?
  remotePreference                        String?
  ageYears                                Int?
  maximumTravelMiles                      Int?
  paidOnlyPreference                      Boolean?
  preferredSeasons                        String[]                                 @default([])
  certifications                          String[]                                 @default([])
  transportationNotes                     String?
  interestedSpecialties                   String[]                                 @default([])
  opportunityTypes                        OpportunityType[]                        @default([])
  availability                            String[]                                 @default([])
  languages                               String[]                                 @default([])
  careerGoals                             String?
  experienceLevel                         String?
  linkedinUrl                             String?
  githubUrl                               String?
  portfolioUrl                            String?
  bio                                     String?
  resumes                                 Resume[]
  experiences                             StudentExperience[]
  stories                                 StudentStory[]
  documents                               StudentDocument[]
  recommendationContacts                  RecommendationContact[]
  aiGenerationRecords                     AiGenerationRecord[]
  applications                            Application[]
  savedOpportunities                      SavedOpportunity[]
  ownedExternalOpportunities              Opportunity[]                            @relation("StudentOwnedOpportunities")
  externalOpportunityVerificationRequests ExternalOpportunityVerificationRequest[]
  notificationPreference                  StudentNotificationPreference?
  placementRequests                       PlacementRequest[]
  adminNotes                              AdminNote[]
  serviceHourRecords                      ServiceHourRecord[]
  eventRegistrations                      EventRegistration[]
  createdAt                               DateTime                                 @default(now())
  updatedAt                               DateTime                                 @updatedAt

  @@index([graduationYear])
}

model StudentImportRecord {
  id                    String            @id @default(cuid())
  email                 String
  normalizedEmail       String            @unique
  firstName             String?
  lastName              String?
  school                String?
  gradeYear             String?
  major                 String?
  graduationYear        Int?
  city                  String?
  state                 String?
  country               String?
  locationPreference    String?
  remotePreference      String?
  interestedSpecialties String[]          @default([])
  opportunityTypes      OpportunityType[] @default([])
  availability          String[]          @default([])
  languages             String[]          @default([])
  careerGoals           String?
  experienceLevel       String?
  claimedAt             DateTime?
  claimedById           String?
  claimedBy             User?             @relation("StudentImportClaim", fields: [claimedById], references: [id], onDelete: SetNull)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([email])
  @@index([claimedAt])
  @@index([claimedById])
}

model Resume {
  id                      String            @id @default(cuid())
  studentProfileId        String
  studentProfile          StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  label                   String?
  purpose                 ResumePurpose     @default(GENERAL)
  customPurpose           String?
  /// Future resume actions must set the single active default transactionally.
  isDefault               Boolean           @default(false)
  archivedAt              DateTime?
  duplicatedFromId        String?
  duplicatedFrom          Resume?           @relation("ResumeDuplication", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicates              Resume[]          @relation("ResumeDuplication")
  fileName                String
  fileUrl                 String?
  parseStatus             ResumeParseStatus @default(NOT_STARTED)
  parsedText              String?
  parsedSummary           String?
  extractedSkills         String[]          @default([])
  extractedEducation      String[]          @default([])
  extractedExperience     String[]          @default([])
  extractedCertifications String[]          @default([])
  applications            Application[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([studentProfileId])
  @@index([studentProfileId, archivedAt])
  @@index([studentProfileId, isDefault])
  @@index([duplicatedFromId])
  @@index([parseStatus])
}

model PartnerOrganization {
  id                    String                    @id @default(cuid())
  name                  String                    @unique
  isSystemPlaceholder   Boolean                   @default(false)
  status                PartnerStatus             @default(NOT_CONTACTED)
  website               String?
  type                  String?
  description           String?
  location              String?
  city                  String?
  state                 String?
  country               String?
  healthcareFocus       String?
  specialtyAreas        String[]                  @default([])
  contactEmail          String?
  lastContactedAt       DateTime?
  nextFollowUpAt        DateTime?
  verificationStatus    PartnerVerificationStatus @default(UNVERIFIED)
  verificationChecklist String[]                  @default([])
  verificationNotes     String?
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?                     @relation("PartnerVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  members               PartnerMember[]
  opportunities         Opportunity[]
  placementRequests     PlacementRequest[]
  outreachContacts      OutreachContact[]
  outreachTasks         OutreachTask[]
  adminNotes            AdminNote[]
  serviceHourRecords    ServiceHourRecord[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([status])
  @@index([isSystemPlaceholder])
  @@index([status, createdAt])
  @@index([verificationStatus])
  @@index([nextFollowUpAt])
  @@index([createdAt])
}

model PartnerMember {
  id             String              @id @default(cuid())
  userId         String
  organizationId String
  title          String?
  isPrimary      Boolean             @default(false)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Opportunity {
  id                           String                                   @id @default(cuid())
  organizationId               String
  organization                 PartnerOrganization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title                        String
  description                  String?
  shortDescription             String?
  fpSummary                    String?
  type                         OpportunityType
  specialty                    String?
  status                       OpportunityStatus                        @default(DRAFT)
  relationshipType             OpportunityRelationshipType              @default(EXTERNAL_PUBLIC)
  applicationMethod            ApplicationMethod                        @default(EXTERNAL_PORTAL)
  officialSourceUrl            String?
  officialApplicationUrl       String?
  relationshipNotes            String?
  verificationStatus           OpportunityVerificationStatus            @default(NEEDS_REVIEW)
  lastVerifiedAt               DateTime?
  nextVerificationAt           DateTime?
  verifiedById                 String?
  verifiedBy                   User?                                    @relation("OpportunityVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationNotes            String?
  brokenLinkDetectedAt         DateTime?
  archivalReason               String?
  visibility                   OpportunityVisibility                    @default(PUBLIC_DIRECTORY)
  sourceType                   OpportunitySourceType                    @default(FP_CATALOG)
  studentOwnerProfileId        String?
  studentOwner                 StudentProfile?                          @relation("StudentOwnedOpportunities", fields: [studentOwnerProfileId], references: [id], onDelete: Cascade)
  studentSourceUrlNormalized   String?
  studentOrganizationName      String?
  availabilityStatus           OpportunityAvailabilityStatus            @default(OPEN)
  opensAt                      DateTime?
  isRolling                    Boolean                                  @default(false)
  cycleLabel                   String?
  location                     String?
  remoteType                   String?
  address                      String?
  city                         String?
  state                        String?
  country                      String?
  postalCode                   String?
  geographicScope              String?
  transportationNotes          String?
  maximumTravelMiles           Int?
  paidStatus                   String?
  deadline                     DateTime?
  capacity                     Int?
  eligibilityRequirements      String?
  minimumAge                   Int?
  maximumAge                   Int?
  acceptedGradeLevels          GradeLevelCode[]                         @default([])
  minimumGpa                   Float?
  residencyRequirement         String?
  citizenshipRequirement       String?
  requiredExperience           String?
  requiredCertifications       String[]                                 @default([])
  parentPermissionRequired     Boolean?
  workAuthorizationRequired    Boolean?
  eligibilityUnknowns          String[]                                 @default([])
  requiredDocuments            String[]                                 @default([])
  applicationInstructions      String?
  estimatedApplicationMinutes  Int?
  essayQuestionCount           Int?
  scheduleRequirements         String?
  estimatedWeeklyHours         Float?
  startsAt                     DateTime?
  endsAt                       DateTime?
  publishedAt                  DateTime?
  moderationFlags              String[]                                 @default([])
  moderationNotes              String?
  moderatedAt                  DateTime?
  moderatedById                String?
  moderatedBy                  User?                                    @relation("OpportunityModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  applications                 Application[]
  savedByStudents              SavedOpportunity[]
  correctionReports            OpportunityCorrectionReport[]
  placementRequests            PlacementRequest[]
  adminNotes                   AdminNote[]
  recommendationEvents         RecommendationEvent[]
  serviceHourRecords           ServiceHourRecord[]
  notifications                Notification[]
  externalVerificationRequests ExternalOpportunityVerificationRequest[]
  createdAt                    DateTime                                 @default(now())
  updatedAt                    DateTime                                 @updatedAt

  @@unique([studentOwnerProfileId, studentSourceUrlNormalized])
  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([status, deadline])
  @@index([organizationId, status, createdAt])
  @@index([moderatedById])
  @@index([verifiedById])
  @@index([visibility])
  @@index([sourceType])
  @@index([studentOwnerProfileId])
  @@index([verificationStatus])
  @@index([availabilityStatus])
  @@index([relationshipType])
  @@index([applicationMethod])
  @@index([nextVerificationAt])
  @@index([deadline])
  @@index([officialSourceUrl])
  @@index([organizationId, title])
  @@index([createdAt])
}

model Application {
  id                     String                            @id @default(cuid())
  studentProfileId       String
  opportunityId          String
  resumeId               String?
  studentProfile         StudentProfile                    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  opportunity            Opportunity                       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  resume                 Resume?                           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  status                 ApplicationStatus                 @default(DRAFT)
  applicationMethod      ApplicationMethod                 @default(EXTERNAL_PORTAL)
  statement              String?
  submittedAt            DateTime?
  targetDeadline         DateTime?
  completionPercent      Int                               @default(0)
  nextAction             String?
  privateNotes           String?
  submissionConfirmation String?
  outcomeNotes           String?
  lastActivityAt         DateTime                          @default(now())
  reviewedAt             DateTime?
  onboardingItems        ApplicationOnboardingItem[]
  tasks                  ApplicationTask[]
  selectedExperiences    ApplicationExperience[]
  documents              StudentDocument[]
  recommendations        ApplicationRecommendation[]
  questions              ApplicationQuestion[]
  interviews             ApplicationInterviewPreparation[]
  outcomeReport          ApplicationOutcomeReport?
  activityTimeline       ApplicationActivity[]
  aiGenerationRecords    AiGenerationRecord[]
  notifications          Notification[]
  recommendationEvents   RecommendationEvent[]
  interviewRequests      InterviewRequest[]
  serviceHourRecords     ServiceHourRecord[]
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime                          @updatedAt

  @@unique([studentProfileId, opportunityId])
  @@index([resumeId])
  @@index([status])
  @@index([applicationMethod])
  @@index([status, submittedAt])
  @@index([opportunityId, status, submittedAt])
  @@index([createdAt])
}

model SavedOpportunity {
  id               String         @id @default(cuid())
  studentProfileId String
  opportunityId    String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  opportunity      Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  followReopening  Boolean        @default(false)
  dismissedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentProfileId, opportunityId])
  @@index([opportunityId])
  @@index([studentProfileId, updatedAt])
}

model ApplicationTask {
  id                String                @id @default(cuid())
  applicationId     String
  application       Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type              ApplicationTaskType   @default(CUSTOM)
  title             String                @map("label")
  description       String?
  status            ApplicationTaskStatus @default(NOT_STARTED)
  required          Boolean               @default(true)
  dueAt             DateTime?             @db.Date
  completedAt       DateTime?
  source            String?
  taskKey           String?
  studentControlled Boolean               @default(false)
  linkedEntityType  String?
  linkedEntityId    String?
  sortOrder         Int                   @default(0)
  notifications     Notification[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([applicationId, title])
  @@unique([applicationId, taskKey])
  @@index([applicationId, sortOrder])
  @@index([applicationId, status, dueAt])
  @@index([status, dueAt])
  @@map("ApplicationChecklistItem")
}

model StudentExperience {
  id                      String                               @id @default(cuid())
  studentProfileId        String
