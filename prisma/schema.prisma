  IN_PROGRESS
  BLOCKED
  COMPLETE
  SKIPPED
}

enum StudentNotificationType {
  GENERAL
  OPPORTUNITY_OPENING_SOON
  OPPORTUNITY_OPENED
  APPLICATION_DEADLINE
  INTERNAL_TARGET_DEADLINE
  TASK_OVERDUE
  RECOMMENDATION_REQUEST
  RECOMMENDATION_DEADLINE
  INTERVIEW_REMINDER
  POST_INTERVIEW_THANK_YOU
  POST_SUBMISSION_FOLLOW_UP
