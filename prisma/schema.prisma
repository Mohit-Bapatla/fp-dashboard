generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  PARTNER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum OpportunityType {
  INTERNSHIP
  SHADOWING
  RESEARCH
  VOLUNTEERING
  MENTORSHIP
  EVENT
  PROGRAM
}

enum OpportunityStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
  CLOSED
  REJECTED
}

enum ApplicationStatus {
  DRAFT
  SAVED
  PLANNING
  PREPARING
  WAITING_FOR_RECOMMENDATION
  READY_TO_SUBMIT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW
  WAITLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ApplicationMethod {
  EXTERNAL_PORTAL
  FP_INTERNAL
  FP_REFERRAL
}

enum GradeLevelCode {
  HS_9
  HS_10
  HS_11
  HS_12
  COLLEGE_1
  COLLEGE_2
  COLLEGE_3
  COLLEGE_4
  GRADUATE
  MEDICAL
  GAP_YEAR_POST_BACC
}

enum OpportunityRelationshipType {
  EXTERNAL_PUBLIC
  FP_PARTNER
  FP_OWNED
}

enum OpportunityVerificationStatus {
  NEEDS_REVIEW
  VERIFIED
  STALE
  BROKEN_LINK
  REJECTED
  ARCHIVED
