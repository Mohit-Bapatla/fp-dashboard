generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  PARTNER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum OpportunityType {
  INTERNSHIP
  SHADOWING
  RESEARCH
  VOLUNTEERING
  MENTORSHIP
  EVENT
  PROGRAM
}

enum OpportunityStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
  CLOSED
  REJECTED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PlacementRequestStatus {
  NEW
  ASSIGNED
  RESEARCHING
  OUTREACH_IN_PROGRESS
  PARTNER_CONTACTED
  WAITING_FOR_PARTNER
  OPPORTUNITY_FOUND
  STUDENT_REFERRED
  PLACED
  CLOSED
}

enum OutreachTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  COMPLETED
  BLOCKED
}

enum PartnerStatus {
  NOT_CONTACTED
  CONTACTED
  FOLLOW_UP_NEEDED
  INTERESTED
  MEETING_SCHEDULED
  PARTNERED
  REJECTED
  NO_RESPONSE
  PAUSED
}

enum ResumeParseStatus {
  NOT_STARTED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                         String             @id @default(cuid())
  clerkUserId                String             @unique
  email                      String             @unique
  firstName                  String?
  lastName                   String?
  role                       UserRole           @default(STUDENT)
  studentProfile             StudentProfile?
  partnerMemberships         PartnerMember[]
  placementRequestsRequested PlacementRequest[] @relation("PlacementRequestRequester")
  outreachTasksAssigned      OutreachTask[]      @relation("OutreachTaskAssignee")
  outreachTasksCreated       OutreachTask[]      @relation("OutreachTaskCreator")
  notifications              Notification[]
  adminNotesAuthored         AdminNote[]         @relation("AdminNoteAuthor")
  adminNotesAbout            AdminNote[]         @relation("AdminNoteUser")
  auditLogs                  AuditLog[]          @relation("AuditLogActor")
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([role])
  @@index([createdAt])
}

model StudentProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  school              String?
  gradeYear           String?
  major               String?
  graduationYear      Int?
  city                String?
  state               String?
  country             String?
  locationPreference  String?
  remotePreference    String?
  interestedSpecialties String[]         @default([])
  opportunityTypes    OpportunityType[]  @default([])
  availability        String[]           @default([])
  languages           String[]           @default([])
  careerGoals         String?
  experienceLevel     String?
  linkedinUrl         String?
  githubUrl           String?
  portfolioUrl        String?
  bio                 String?
  resumes             Resume[]
  applications        Application[]
  placementRequests   PlacementRequest[]
  adminNotes          AdminNote[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([graduationYear])
}

model Resume {
  id               String            @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String?
  parseStatus      ResumeParseStatus @default(NOT_STARTED)
  parsedText       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([studentProfileId])
  @@index([parseStatus])
}

model PartnerOrganization {
  id                String             @id @default(cuid())
  name              String             @unique
  status            PartnerStatus      @default(NOT_CONTACTED)
  website           String?
  type              String?
  description       String?
  location          String?
  city              String?
  state             String?
  country           String?
  healthcareFocus   String?
  specialtyAreas    String[]           @default([])
  contactEmail      String?
  members           PartnerMember[]
  opportunities     Opportunity[]
  placementRequests PlacementRequest[]
  outreachContacts  OutreachContact[]
  outreachTasks     OutreachTask[]
  adminNotes        AdminNote[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
}

model PartnerMember {
  id             String              @id @default(cuid())
  userId         String
  organizationId String
  title          String?
  isPrimary      Boolean             @default(false)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Opportunity {
  id                String             @id @default(cuid())
  organizationId    String
  organization      PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  type              OpportunityType
  specialty         String?
  status            OpportunityStatus  @default(DRAFT)
  location          String?
  remoteType        String?
  paidStatus        String?
  deadline          DateTime?
  capacity          Int?
  eligibilityRequirements String?
  requiredDocuments String[]           @default([])
  applicationInstructions String?
  startsAt          DateTime?
  endsAt            DateTime?
  publishedAt       DateTime?
  applications      Application[]
  placementRequests PlacementRequest[]
  adminNotes        AdminNote[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Application {
  id               String            @id @default(cuid())
  studentProfileId String
  opportunityId    String
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  opportunity      Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status           ApplicationStatus @default(DRAFT)
  statement        String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([studentProfileId, opportunityId])
  @@index([status])
  @@index([createdAt])
}

model PlacementRequest {
  id                    String                 @id @default(cuid())
  studentProfileId      String
  opportunityId         String?
  partnerOrganizationId String?
  requestedById         String?
  studentProfile        StudentProfile         @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  opportunity           Opportunity?           @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  partnerOrganization   PartnerOrganization?   @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  requestedBy           User?                  @relation("PlacementRequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  status                PlacementRequestStatus @default(NEW)
  title                 String
  description           String?
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([studentProfileId])
  @@index([opportunityId])
  @@index([partnerOrganizationId])
  @@index([requestedById])
  @@index([status])
  @@index([createdAt])
}

model OutreachContact {
  id             String              @id @default(cuid())
  organizationId String
  organization   PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  title          String?
  notes          String?
  tasks          OutreachTask[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([email])
}

model OutreachTask {
  id                    String              @id @default(cuid())
  contactId             String?
  partnerOrganizationId String?
  assignedToId          String?
  createdById           String?
  contact               OutreachContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  partnerOrganization   PartnerOrganization? @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  assignedTo            User?               @relation("OutreachTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy             User?               @relation("OutreachTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title                 String
  description           String?
  status                OutreachTaskStatus  @default(NOT_STARTED)
  dueAt                 DateTime?
  completedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([contactId])
  @@index([partnerOrganizationId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([dueAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model AdminNote {
  id                    String               @id @default(cuid())
  authorId              String?
  userId                String?
  studentProfileId      String?
  partnerOrganizationId String?
  opportunityId         String?
  author                User?                @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  user                  User?                @relation("AdminNoteUser", fields: [userId], references: [id], onDelete: SetNull)
  studentProfile        StudentProfile?      @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)
  partnerOrganization   PartnerOrganization? @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  opportunity           Opportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  body                  String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([authorId])
  @@index([userId])
  @@index([studentProfileId])
  @@index([partnerOrganizationId])
  @@index([opportunityId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
