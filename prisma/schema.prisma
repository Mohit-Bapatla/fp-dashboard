  assignedStaffId           String?
  studentProfile            StudentProfile         @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  opportunity               Opportunity?           @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  partnerOrganization       PartnerOrganization?   @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  requestedBy               User?                  @relation("PlacementRequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)
