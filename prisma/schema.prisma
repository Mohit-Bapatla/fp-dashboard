  CLOSED
  ARCHIVED
}

enum SponsorshipCommitmentStatus {
  PLEDGED
  COMMITTED
  RECEIVED
  CANCELED
  DECLINED
}

enum SponsorDeliverableType {
  LOGO_PLACEMENT
  EVENT_MENTION
  NEWSLETTER_MENTION
  SOCIAL_POST
  THANK_YOU_EMAIL
  OTHER
}

enum SponsorDeliverableStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  WAIVED
}

enum SponsorInteractionType {
  NOTE
  EMAIL
  CALL
  MEETING
  FOLLOW_UP
}

enum RecordCommentEntityType {
  APPLICATION
  PLACEMENT_REQUEST
  OUTREACH_TASK
}

enum RecordCommentVisibility {
  INTERNAL
  PARTNER_VISIBLE
  STUDENT_VISIBLE
}

enum PartnerVerificationStatus {
  UNVERIFIED
  IN_REVIEW
  VERIFIED
  SUSPENDED
}

enum FeedbackType {
  STUDENT_APPLICATION_EXPERIENCE
  STUDENT_PLACEMENT_REQUEST
  PARTNER_APPLICANT_QUALITY
  PARTNER_REVIEW_USEFULNESS
  STAFF_MATCH_QUALITY
  STAFF_PLACEMENT_DIFFICULTY
}

enum FeedbackEntityType {
  APPLICATION
  OPPORTUNITY
  PLACEMENT_REQUEST
  USER
}

enum RecommendationEventType {
  IMPRESSION
  CLICK
  APPLICATION
  SEARCH_RESULTS
}

enum EmbeddingEntityType {
  OPPORTUNITY
  STUDENT_PROFILE
  RESUME
  PARTNER_ORGANIZATION
}

model User {
  id                                   String                                   @id @default(cuid())
  clerkUserId                          String                                   @unique
  email                                String                                   @unique
  firstName                            String?
  lastName                             String?
  role                                 UserRole                                 @default(STUDENT)
  studentProfile                       StudentProfile?
  partnerMemberships                   PartnerMember[]
  placementRequestsRequested           PlacementRequest[]                       @relation("PlacementRequestRequester")
  placementRequestsAssigned            PlacementRequest[]                       @relation("PlacementRequestAssignee")
  outreachTasksAssigned                OutreachTask[]                           @relation("OutreachTaskAssignee")
  outreachTasksCreated                 OutreachTask[]                           @relation("OutreachTaskCreator")
  notifications                        Notification[]
  adminNotesAuthored                   AdminNote[]                              @relation("AdminNoteAuthor")
  adminNotesAbout                      AdminNote[]                              @relation("AdminNoteUser")
  auditLogs                            AuditLog[]                               @relation("AuditLogActor")
  recordComments                       RecordComment[]                          @relation("RecordCommentAuthor")
  onboardingItemsReviewed              ApplicationOnboardingItem[]              @relation("OnboardingItemReviewer")
  verifiedPartnerOrganizations         PartnerOrganization[]                    @relation("PartnerVerifier")
  moderatedOpportunities               Opportunity[]                            @relation("OpportunityModerator")
  verifiedOpportunities                Opportunity[]                            @relation("OpportunityVerifier")
  reviewedExternalOpportunityRequests  ExternalOpportunityVerificationRequest[] @relation("ExternalOpportunityVerificationReviewer")
  opportunityCorrectionReports         OpportunityCorrectionReport[]            @relation("OpportunityCorrectionReporter")
  reviewedOpportunityCorrectionReports OpportunityCorrectionReport[]            @relation("OpportunityCorrectionReviewer")
  claimedStudentImportRecords          StudentImportRecord[]                    @relation("StudentImportClaim")
  feedbackAuthored                     Feedback[]                               @relation("FeedbackAuthor")
  recommendationEvents                 RecommendationEvent[]                    @relation("RecommendationEventUser")
  dataQualityAcknowledgements          DataQualityAcknowledgement[]             @relation("DataQualityAcknowledgementUser")
  interviewRequestsCreated             InterviewRequest[]                       @relation("InterviewRequestCreator")
  interviewRequestsCanceled            InterviewRequest[]                       @relation("InterviewRequestCanceler")
  serviceHoursVerified                 ServiceHourRecord[]                      @relation("ServiceHourVerifier")
  certificatesApproved                 ServiceHourRecord[]                      @relation("CertificateApprover")
  programEventsCreated                 ProgramEvent[]                           @relation("ProgramEventCreator")
  eventRegistrationsCheckedIn          EventRegistration[]                      @relation("EventRegistrationCheckIn")
  sponsorInteractionsAuthored          SponsorInteraction[]                     @relation("SponsorInteractionAuthor")
  createdAt                            DateTime                                 @default(now())
  updatedAt                            DateTime                                 @updatedAt

  @@index([role])
  @@index([role, createdAt])
  @@index([createdAt])
}

model StudentProfile {
  id                                      String                                   @id @default(cuid())
  userId                                  String                                   @unique
  user                                    User                                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school                                  String?
  gradeYear                               String?
  major                                   String?
  graduationYear                          Int?
  city                                    String?
  state                                   String?
  country                                 String?
  locationPreference                      String?
  remotePreference                        String?
  ageYears                                Int?
  maximumTravelMiles                      Int?
  paidOnlyPreference                      Boolean?
  preferredSeasons                        String[]                                 @default([])
  certifications                          String[]                                 @default([])
  transportationNotes                     String?
  interestedSpecialties                   String[]                                 @default([])
  opportunityTypes                        OpportunityType[]                        @default([])
  availability                            String[]                                 @default([])
  languages                               String[]                                 @default([])
  careerGoals                             String?
  experienceLevel                         String?
  linkedinUrl                             String?
  githubUrl                               String?
  portfolioUrl                            String?
  bio                                     String?
  resumes                                 Resume[]
  applications                            Application[]
  savedOpportunities                      SavedOpportunity[]
  ownedExternalOpportunities              Opportunity[]                            @relation("StudentOwnedOpportunities")
  externalOpportunityVerificationRequests ExternalOpportunityVerificationRequest[]
  notificationPreference                  StudentNotificationPreference?
  placementRequests                       PlacementRequest[]
  adminNotes                              AdminNote[]
  serviceHourRecords                      ServiceHourRecord[]
  eventRegistrations                      EventRegistration[]
  createdAt                               DateTime                                 @default(now())
  updatedAt                               DateTime                                 @updatedAt

  @@index([graduationYear])
}

model StudentImportRecord {
  id                    String            @id @default(cuid())
  email                 String
  normalizedEmail       String            @unique
  firstName             String?
  lastName              String?
  school                String?
  gradeYear             String?
  major                 String?
  graduationYear        Int?
  city                  String?
  state                 String?
  country               String?
  locationPreference    String?
  remotePreference      String?
  interestedSpecialties String[]          @default([])
  opportunityTypes      OpportunityType[] @default([])
  availability          String[]          @default([])
  languages             String[]          @default([])
  careerGoals           String?
  experienceLevel       String?
  claimedAt             DateTime?
  claimedById           String?
  claimedBy             User?             @relation("StudentImportClaim", fields: [claimedById], references: [id], onDelete: SetNull)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([email])
  @@index([claimedAt])
  @@index([claimedById])
}

model Resume {
  id                      String                    @id @default(cuid())
  studentProfileId        String
  studentProfile          StudentProfile            @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  fileName                String
  fileUrl                 String?
  uploadedAt              DateTime                  @default(now())
  analyzedAt              DateTime?
  parseStatus             ResumeParseStatus         @default(NOT_STARTED)
  parseFailureReason      ResumeParseFailureReason?
  parsedText              String?
  parsedSummary           String?
  extractedSkills         String[]                  @default([])
  extractedEducation      String[]                  @default([])
  extractedExperience     String[]                  @default([])
  extractedCertifications String[]                  @default([])
  applications            Application[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([studentProfileId])
  @@index([parseStatus])
}

model PartnerOrganization {
  id                    String                    @id @default(cuid())
  name                  String                    @unique
  isSystemPlaceholder   Boolean                   @default(false)
  status                PartnerStatus             @default(NOT_CONTACTED)
  website               String?
  type                  String?
  description           String?
  location              String?
  city                  String?
  state                 String?
  country               String?
  healthcareFocus       String?
  specialtyAreas        String[]                  @default([])
  contactEmail          String?
  lastContactedAt       DateTime?
  nextFollowUpAt        DateTime?
  verificationStatus    PartnerVerificationStatus @default(UNVERIFIED)
  verificationChecklist String[]                  @default([])
  verificationNotes     String?
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?                     @relation("PartnerVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  members               PartnerMember[]
  opportunities         Opportunity[]
  placementRequests     PlacementRequest[]
  outreachContacts      OutreachContact[]
  outreachTasks         OutreachTask[]
  adminNotes            AdminNote[]
  serviceHourRecords    ServiceHourRecord[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([status])
  @@index([isSystemPlaceholder])
  @@index([status, createdAt])
  @@index([verificationStatus])
  @@index([verifiedById])
  @@index([nextFollowUpAt])
  @@index([createdAt])
}

model PartnerMember {
  id             String              @id @default(cuid())
  userId         String
  organizationId String
  title          String?
  isPrimary      Boolean             @default(false)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Opportunity {
  id                           String                                   @id @default(cuid())
  slug                         String?                                  @unique
  sourceKey                    String?                                  @unique
  organizationId               String
  organization                 PartnerOrganization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title                        String
  description                  String?
  shortDescription             String?
  fpSummary                    String?
  type                         OpportunityType
  specialty                    String?
  status                       OpportunityStatus                        @default(DRAFT)
  relationshipType             OpportunityRelationshipType              @default(EXTERNAL_PUBLIC)
  applicationMethod            ApplicationMethod                        @default(EXTERNAL_PORTAL)
  officialSourceUrl            String?
  officialApplicationUrl       String?
  secondarySourceUrl           String?
  sourceTitle                  String?
  sourceOrganization           String?
  sourceRetrievedAt            DateTime?
  verificationMethod           String?
  sourceNotes                  String?
  sourceChangeFingerprint      String?
  originalImportedValues       Json?
  relationshipNotes            String?
  verificationStatus           OpportunityVerificationStatus            @default(NEEDS_REVIEW)
  lastVerifiedAt               DateTime?
  nextVerificationAt           DateTime?
  verifiedById                 String?
  verifiedBy                   User?                                    @relation("OpportunityVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationNotes            String?
  brokenLinkDetectedAt         DateTime?
  archivalReason               String?
  duplicateGroup               String?
  dataQualityScore             Int?
  completenessScore            Int?
  featured                     Boolean                                  @default(false)
  adminReviewStatus            OpportunityAdminReviewStatus             @default(PENDING)
  adminReviewedAt              DateTime?
  adminReviewedById            String?
  partnerSubmitted             Boolean                                  @default(false)
  adminApprovedAt              DateTime?
  internalNotes                String?
  publicNotes                  String?
  visibility                   OpportunityVisibility                    @default(PUBLIC_DIRECTORY)
  sourceType                   OpportunitySourceType                    @default(FP_CATALOG)
  studentOwnerProfileId        String?
  studentOwner                 StudentProfile?                          @relation("StudentOwnedOpportunities", fields: [studentOwnerProfileId], references: [id], onDelete: Cascade)
  studentSourceUrlNormalized   String?
  studentOrganizationName      String?
  availabilityStatus           OpportunityAvailabilityStatus            @default(OPEN)
  opensAt                      DateTime?
  isRolling                    Boolean                                  @default(false)
  cycleLabel                   String?
  location                     String?
  remoteType                   String?
  address                      String?
  city                         String?
  state                        String?
  country                      String?
  postalCode                   String?
  geographicScope              String?
  transportationNotes          String?
  maximumTravelMiles           Int?
  paidStatus                   String?
  compensationType             String?
  compensationAmount           String?
  stipendInformation           String?
  feesOrCosts                  String?
  travelRequirements           String?
  housingInformation           String?
  schoolCreditAvailability     String?
  deadline                     DateTime?
  priorityDeadline             DateTime?
  capacity                     Int?
  eligibilityRequirements      String?
  educationRequirement         String?
  geographicRequirement        String?
  prerequisiteCourses          String[]                                 @default([])
  backgroundCheckRequirement   String?
  healthClearanceRequirement   String?
  additionalRestrictions       String?
  eligibilityNotes             String?
  minimumAge                   Int?
  maximumAge                   Int?
  acceptedGradeLevels          GradeLevelCode[]                         @default([])
  minimumGpa                   Float?
  residencyRequirement         String?
  citizenshipRequirement       String?
  requiredExperience           String?
  requiredCertifications       String[]                                 @default([])
  parentPermissionRequired     Boolean?
  workAuthorizationRequired    Boolean?
  eligibilityUnknowns          String[]                                 @default([])
  requiredDocuments            String[]                                 @default([])
  applicationInstructions      String?
  applicationContactEmail      String?
  interviewProcess             String?
  selectionTimeline            String?
  estimatedApplicationMinutes  Int?
  essayQuestionCount           Int?
  scheduleRequirements         String?
  estimatedWeeklyHours         Float?
  duration                     String?
  responsibilities             String?
  skillsOffered                String[]                                 @default([])
  startsAt                     DateTime?
  endsAt                       DateTime?
  publishedAt                  DateTime?
  moderationFlags              String[]                                 @default([])
  moderationNotes              String?
  moderatedAt                  DateTime?
  moderatedById                String?
  moderatedBy                  User?                                    @relation("OpportunityModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  applications                 Application[]
  savedByStudents              SavedOpportunity[]
  correctionReports            OpportunityCorrectionReport[]
  placementRequests            PlacementRequest[]
  adminNotes                   AdminNote[]
  recommendationEvents         RecommendationEvent[]
  serviceHourRecords           ServiceHourRecord[]
  notifications                Notification[]
  externalVerificationRequests ExternalOpportunityVerificationRequest[]
  importRows                   OpportunityImportRow[]
  fieldOverrides               OpportunityFieldOverride[]
  changeEvents                 OpportunityChangeEvent[]
  verificationChecks           OpportunityVerificationCheck[]
  createdAt                    DateTime                                 @default(now())
  updatedAt                    DateTime                                 @updatedAt

  @@unique([studentOwnerProfileId, studentSourceUrlNormalized])
  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([status, deadline])
  @@index([organizationId, status, createdAt])
  @@index([moderatedById])
  @@index([verifiedById])
  @@index([visibility])
  @@index([sourceType])
  @@index([studentOwnerProfileId])
  @@index([verificationStatus])
  @@index([availabilityStatus])
  @@index([relationshipType])
  @@index([applicationMethod])
  @@index([nextVerificationAt])
  @@index([deadline])
  @@index([officialSourceUrl])
  @@index([officialApplicationUrl])
  @@index([duplicateGroup])
  @@index([adminReviewStatus])
  @@index([featured, publishedAt])
  @@index([sourceRetrievedAt])
  @@index([organizationId, title])
  @@index([createdAt])
}

model OpportunityImportRun {
  id                 String                       @id @default(cuid())
  sourceFileName     String
  sourceFileHash     String
  environment        OpportunityImportEnvironment
  targetProjectRef   String
  targetDatabase     String                       @default("postgres")
  targetSchema       String                       @default("public")
  dryRun             Boolean                      @default(true)
  status             OpportunityImportRunStatus   @default(DRY_RUN)
  submittedById      String?
  approvedById       String?
  approvedAt         DateTime?
  totalRows          Int                          @default(0)
  createdCount       Int                          @default(0)
  updatedCount       Int                          @default(0)
  unchangedCount     Int                          @default(0)
  rejectedCount      Int                          @default(0)
  duplicateCount     Int                          @default(0)
  needsReviewCount   Int                          @default(0)
  publishedCount     Int                          @default(0)
  archivedCount      Int                          @default(0)
  restoredCount      Int                          @default(0)
  errorSummary       String?
  report             Json?
  reversalOfImportId String?
  startedAt          DateTime?
  completedAt        DateTime?
  reversedAt         DateTime?
  rows               OpportunityImportRow[]
  changeEvents       OpportunityChangeEvent[]
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@index([status, createdAt])
  @@index([environment, createdAt])
  @@index([sourceFileHash])
  @@index([submittedById])
  @@index([approvedById])
  @@index([reversalOfImportId])
}

model OpportunityImportRow {
  id                     String                     @id @default(cuid())
  importRunId            String
  importRun              OpportunityImportRun       @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  rowNumber              Int
  sourceKey              String?
  slug                   String?
  action                 OpportunityImportRowAction
  opportunityId          String?
  opportunity            Opportunity?               @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  duplicateOpportunityId String?
  officialSourceUrl      String?
  officialApplicationUrl String?
  originalData           Json
  normalizedData         Json?
  proposedChanges        Json?
  validationErrors       String[]                   @default([])
  warnings               String[]                   @default([])
  createdAt              DateTime                   @default(now())

  @@unique([importRunId, rowNumber])
  @@index([importRunId, action])
  @@index([sourceKey])
  @@index([opportunityId])
  @@index([duplicateOpportunityId])
}

model OpportunityFieldOverride {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fieldName     String
  value         Json?
  reason        String
  active        Boolean     @default(true)
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([opportunityId, fieldName])
  @@index([active, updatedAt])
  @@index([createdById])
}

model OpportunityChangeEvent {
  id            String                @id @default(cuid())
  opportunityId String
  opportunity   Opportunity           @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  importRunId   String?
  importRun     OpportunityImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  action        String
  actorId       String?
  previousData  Json?
  nextData      Json?
  metadata      Json?
  createdAt     DateTime              @default(now())

  @@index([opportunityId, createdAt])
  @@index([importRunId])
  @@index([actorId, createdAt])
}

model OpportunityVerificationCheck {
  id                  String                              @id @default(cuid())
  opportunityId       String
  opportunity         Opportunity                         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  checkedUrl          String
  checkedAt           DateTime                            @default(now())
  result              OpportunityVerificationCheckResult
  httpStatus          Int?
  redirectUrl         String?
  contentFingerprint  String?
  previousFingerprint String?
  contentChanged      Boolean                             @default(false)
  errorCode           String?
  suggestedAction     String?
  reviewStatus        OpportunityVerificationReviewStatus @default(PENDING)
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime                            @default(now())

  @@index([opportunityId, checkedAt])
  @@index([reviewStatus, checkedAt])
  @@index([result, checkedAt])
}

model Application {
  id                     String                      @id @default(cuid())
  studentProfileId       String
  opportunityId          String
  resumeId               String?
  studentProfile         StudentProfile              @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  opportunity            Opportunity                 @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  resume                 Resume?                     @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  status                 ApplicationStatus           @default(DRAFT)
  applicationMethod      ApplicationMethod           @default(EXTERNAL_PORTAL)
  statement              String?
  submittedAt            DateTime?
  targetDeadline         DateTime?
  completionPercent      Int                         @default(0)
  nextAction             String?
  privateNotes           String?
  submissionConfirmation String?
  outcomeNotes           String?
  lastActivityAt         DateTime                    @default(now())
  reviewedAt             DateTime?
  onboardingItems        ApplicationOnboardingItem[]
  tasks                  ApplicationTask[]
  notifications          Notification[]
  recommendationEvents   RecommendationEvent[]
  interviewRequests      InterviewRequest[]
  serviceHourRecords     ServiceHourRecord[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@unique([studentProfileId, opportunityId])
  @@index([resumeId])
  @@index([status])
  @@index([applicationMethod])
  @@index([status, submittedAt])
  @@index([opportunityId, status, submittedAt])
  @@index([createdAt])
}

model SavedOpportunity {
