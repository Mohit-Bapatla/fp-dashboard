generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  PARTNER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum OpportunityType {
  INTERNSHIP
  SHADOWING
  RESEARCH
  VOLUNTEERING
  MENTORSHIP
  EVENT
  PROGRAM
}

enum OpportunityStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
  CLOSED
  REJECTED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PlacementRequestStatus {
  NEW
  ASSIGNED
  RESEARCHING
  OUTREACH_IN_PROGRESS
  PARTNER_CONTACTED
  WAITING_FOR_PARTNER
  OPPORTUNITY_FOUND
  STUDENT_REFERRED
  PLACED
  CLOSED
}

enum OutreachTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  COMPLETED
  BLOCKED
}

enum PartnerStatus {
  NOT_CONTACTED
  CONTACTED
  FOLLOW_UP_NEEDED
  INTERESTED
  MEETING_SCHEDULED
  PARTNERED
  REJECTED
  NO_RESPONSE
  PAUSED
}

enum ResumeParseStatus {
  NOT_STARTED
  PROCESSING
  COMPLETED
  FAILED
}

enum ApplicationOnboardingItemStatus {
  NOT_STARTED
  SUBMITTED
  APPROVED
  NEEDS_CHANGES
  WAIVED
}

enum RecordCommentEntityType {
  APPLICATION
  PLACEMENT_REQUEST
  OUTREACH_TASK
}

enum RecordCommentVisibility {
  INTERNAL
  PARTNER_VISIBLE
  STUDENT_VISIBLE
}

enum PartnerVerificationStatus {
  UNVERIFIED
  IN_REVIEW
  VERIFIED
  SUSPENDED
}

enum FeedbackType {
  STUDENT_APPLICATION_EXPERIENCE
  STUDENT_PLACEMENT_REQUEST
  PARTNER_APPLICANT_QUALITY
  PARTNER_REVIEW_USEFULNESS
  STAFF_MATCH_QUALITY
  STAFF_PLACEMENT_DIFFICULTY
}

enum FeedbackEntityType {
  APPLICATION
  OPPORTUNITY
  PLACEMENT_REQUEST
  USER
}

enum RecommendationEventType {
  IMPRESSION
  CLICK
  APPLICATION
  SEARCH_RESULTS
}

model User {
  id                         String             @id @default(cuid())
  clerkUserId                String             @unique
  email                      String             @unique
  firstName                  String?
  lastName                   String?
  role                       UserRole           @default(STUDENT)
  studentProfile             StudentProfile?
  partnerMemberships         PartnerMember[]
  placementRequestsRequested PlacementRequest[] @relation("PlacementRequestRequester")
  placementRequestsAssigned  PlacementRequest[] @relation("PlacementRequestAssignee")
  outreachTasksAssigned      OutreachTask[]      @relation("OutreachTaskAssignee")
  outreachTasksCreated       OutreachTask[]      @relation("OutreachTaskCreator")
  notifications              Notification[]
  adminNotesAuthored         AdminNote[]         @relation("AdminNoteAuthor")
  adminNotesAbout            AdminNote[]         @relation("AdminNoteUser")
  auditLogs                  AuditLog[]          @relation("AuditLogActor")
  recordComments             RecordComment[]     @relation("RecordCommentAuthor")
  onboardingItemsReviewed    ApplicationOnboardingItem[] @relation("OnboardingItemReviewer")
  verifiedPartnerOrganizations PartnerOrganization[] @relation("PartnerVerifier")
  moderatedOpportunities     Opportunity[]       @relation("OpportunityModerator")
  claimedStudentImportRecords StudentImportRecord[] @relation("StudentImportClaim")
  feedbackAuthored          Feedback[]          @relation("FeedbackAuthor")
  recommendationEvents      RecommendationEvent[] @relation("RecommendationEventUser")
  dataQualityAcknowledgements DataQualityAcknowledgement[] @relation("DataQualityAcknowledgementUser")
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([role])
  @@index([createdAt])
}

model StudentProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  school              String?
  gradeYear           String?
  major               String?
  graduationYear      Int?
  city                String?
  state               String?
  country             String?
  locationPreference  String?
  remotePreference    String?
  interestedSpecialties String[]         @default([])
  opportunityTypes    OpportunityType[]  @default([])
  availability        String[]           @default([])
  languages           String[]           @default([])
  careerGoals         String?
  experienceLevel     String?
  linkedinUrl         String?
  githubUrl           String?
  portfolioUrl        String?
  bio                 String?
  resumes             Resume[]
  applications        Application[]
  placementRequests   PlacementRequest[]
  adminNotes          AdminNote[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([graduationYear])
}

model StudentImportRecord {
  id                    String            @id @default(cuid())
  email                 String
  normalizedEmail       String            @unique
  firstName             String?
  lastName              String?
  school                String?
  gradeYear             String?
  major                 String?
  graduationYear        Int?
  city                  String?
  state                 String?
  country               String?
  locationPreference    String?
  remotePreference      String?
  interestedSpecialties String[]          @default([])
  opportunityTypes      OpportunityType[] @default([])
  availability          String[]          @default([])
  languages             String[]          @default([])
  careerGoals           String?
  experienceLevel       String?
  claimedAt             DateTime?
  claimedById           String?
  claimedBy             User?             @relation("StudentImportClaim", fields: [claimedById], references: [id], onDelete: SetNull)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([email])
  @@index([claimedAt])
  @@index([claimedById])
}

model Resume {
  id               String            @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String?
  parseStatus      ResumeParseStatus @default(NOT_STARTED)
  parsedText       String?
  parsedSummary    String?
  extractedSkills  String[]          @default([])
  extractedEducation String[]        @default([])
  extractedExperience String[]       @default([])
  extractedCertifications String[]   @default([])
  applications     Application[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([studentProfileId])
  @@index([parseStatus])
}

model PartnerOrganization {
  id                String             @id @default(cuid())
  name              String             @unique
  status            PartnerStatus      @default(NOT_CONTACTED)
  website           String?
  type              String?
  description       String?
  location          String?
  city              String?
  state             String?
  country           String?
  healthcareFocus   String?
  specialtyAreas    String[]           @default([])
  contactEmail      String?
  lastContactedAt   DateTime?
  nextFollowUpAt    DateTime?
  verificationStatus PartnerVerificationStatus @default(UNVERIFIED)
  verificationChecklist String[]           @default([])
  verificationNotes String?
  verifiedAt        DateTime?
  verifiedById      String?
  verifiedBy        User?                  @relation("PartnerVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  members           PartnerMember[]
  opportunities     Opportunity[]
  placementRequests PlacementRequest[]
  outreachContacts  OutreachContact[]
  outreachTasks     OutreachTask[]
  adminNotes        AdminNote[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
  @@index([verificationStatus])
  @@index([nextFollowUpAt])
  @@index([createdAt])
}

model PartnerMember {
  id             String              @id @default(cuid())
  userId         String
  organizationId String
  title          String?
  isPrimary      Boolean             @default(false)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Opportunity {
  id                String             @id @default(cuid())
  organizationId    String
  organization      PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  type              OpportunityType
  specialty         String?
  status            OpportunityStatus  @default(DRAFT)
  location          String?
  remoteType        String?
  paidStatus        String?
  deadline          DateTime?
  capacity          Int?
  eligibilityRequirements String?
  requiredDocuments String[]           @default([])
  applicationInstructions String?
  startsAt          DateTime?
  endsAt            DateTime?
  publishedAt       DateTime?
  moderationFlags   String[]           @default([])
  moderationNotes   String?
  moderatedAt       DateTime?
  moderatedById     String?
  moderatedBy       User?              @relation("OpportunityModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  applications      Application[]
  placementRequests PlacementRequest[]
  adminNotes        AdminNote[]
  recommendationEvents RecommendationEvent[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([moderatedById])
  @@index([createdAt])
}

model Application {
  id               String            @id @default(cuid())
  studentProfileId String
  opportunityId    String
  resumeId         String?
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  opportunity      Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  resume           Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  status           ApplicationStatus @default(DRAFT)
  statement        String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  onboardingItems   ApplicationOnboardingItem[]
  recommendationEvents RecommendationEvent[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([studentProfileId, opportunityId])
  @@index([resumeId])
  @@index([status])
  @@index([createdAt])
}

model ApplicationOnboardingItem {
  id            String                          @id @default(cuid())
  applicationId String
  application   Application                     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        ApplicationOnboardingItemStatus @default(NOT_STARTED)
  required      Boolean                         @default(true)
  studentNotes  String?
  reviewerNotes String?
  dueAt         DateTime?
  submittedAt   DateTime?
  completedAt   DateTime?
  reviewedAt    DateTime?
  reviewerId    String?
  reviewer      User?                           @relation("OnboardingItemReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  @@unique([applicationId, title])
  @@index([applicationId])
  @@index([status])
  @@index([reviewerId])
}

model RecordComment {
  id         String                  @id @default(cuid())
  entityType RecordCommentEntityType
  entityId   String
  authorId   String?
  author     User?                   @relation("RecordCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  visibility RecordCommentVisibility @default(INTERNAL)
  body       String
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([authorId])
  @@index([entityType, entityId])
  @@index([visibility])
  @@index([createdAt])
}

model PlacementRequest {
  id                    String                 @id @default(cuid())
  studentProfileId      String
  opportunityId         String?
  partnerOrganizationId String?
  requestedById         String?
  assignedStaffId       String?
  studentProfile        StudentProfile         @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  opportunity           Opportunity?           @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  partnerOrganization   PartnerOrganization?   @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  requestedBy           User?                  @relation("PlacementRequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  assignedStaff         User?                  @relation("PlacementRequestAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  outreachTasks         OutreachTask[]
  status                PlacementRequestStatus @default(NEW)
  title                 String
  description           String?
  requestedSpecialties  String[]               @default([])
  requestedOpportunityTypes OpportunityType[]   @default([])
  locationPreference    String?
  remotePreference      String?
  availability          String[]               @default([])
  urgency               String?
  priority              String                 @default("NORMAL")
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([studentProfileId])
  @@index([opportunityId])
  @@index([partnerOrganizationId])
  @@index([requestedById])
  @@index([assignedStaffId])
  @@index([status])
  @@index([priority])
  @@index([status, priority])
  @@index([createdAt])
}

model OutreachContact {
  id             String              @id @default(cuid())
  organizationId String
  organization   PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  title          String?
  notes          String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  tasks          OutreachTask[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([email])
  @@index([nextFollowUpAt])
}

model OutreachTask {
  id                    String              @id @default(cuid())
  contactId             String?
  partnerOrganizationId String?
  placementRequestId    String?
  assignedToId          String?
  createdById           String?
  contact               OutreachContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  partnerOrganization   PartnerOrganization? @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  placementRequest      PlacementRequest?    @relation(fields: [placementRequestId], references: [id], onDelete: SetNull)
  assignedTo            User?               @relation("OutreachTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy             User?               @relation("OutreachTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title                 String
  description           String?
  notes                 String?
  status                OutreachTaskStatus  @default(NOT_STARTED)
  priority              String              @default("NORMAL")
  dueAt                 DateTime?
  completedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([contactId])
  @@index([partnerOrganizationId])
  @@index([placementRequestId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([status, dueAt])
  @@index([dueAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model AdminNote {
  id                    String               @id @default(cuid())
  authorId              String?
  userId                String?
  studentProfileId      String?
  partnerOrganizationId String?
  opportunityId         String?
  author                User?                @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  user                  User?                @relation("AdminNoteUser", fields: [userId], references: [id], onDelete: SetNull)
  studentProfile        StudentProfile?      @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)
  partnerOrganization   PartnerOrganization? @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  opportunity           Opportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  body                  String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([authorId])
  @@index([userId])
  @@index([studentProfileId])
  @@index([partnerOrganizationId])
  @@index([opportunityId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Feedback {
  id           String             @id @default(cuid())
  authorId     String
  author       User               @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  feedbackType FeedbackType
  entityType   FeedbackEntityType
  entityId     String
  rating       Int
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([authorId, feedbackType, entityType, entityId])
  @@index([authorId])
  @@index([feedbackType])
  @@index([entityType, entityId])
  @@index([rating])
  @@index([createdAt])
}

model RecommendationEvent {
  id            String                  @id @default(cuid())
  userId        String?
  user          User?                   @relation("RecommendationEventUser", fields: [userId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity?            @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  applicationId String?
  application   Application?            @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  eventType     RecommendationEventType
  source        String
  matchScore    Int?
  searchQuery   String?
  resultCount   Int?
  metadata      Json?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([userId])
  @@index([opportunityId])
  @@index([applicationId])
  @@index([eventType])
  @@index([source])
  @@index([createdAt])
}

model DataQualityAcknowledgement {
  id               String   @id @default(cuid())
  entityType       String
  entityId         String
  issueKey         String
  acknowledgedById String
  acknowledgedBy   User     @relation("DataQualityAcknowledgementUser", fields: [acknowledgedById], references: [id], onDelete: Cascade)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([entityType, entityId, issueKey])
  @@index([acknowledgedById])
  @@index([entityType, entityId])
  @@index([issueKey])
  @@index([createdAt])
}
