  partnerOrganizationId     String?
  requestedById             String?
  assignedStaffId           String?
  studentProfile            StudentProfile         @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  opportunity               Opportunity?           @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  partnerOrganization       PartnerOrganization?   @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  requestedBy               User?                  @relation("PlacementRequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  assignedStaff             User?                  @relation("PlacementRequestAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  outreachTasks             OutreachTask[]
  status                    PlacementRequestStatus @default(NEW)
  title                     String
  description               String?
  requestedSpecialties      String[]               @default([])
  requestedOpportunityTypes OpportunityType[]      @default([])
  locationPreference        String?
  remotePreference          String?
  availability              String[]               @default([])
  urgency                   String?
  priority                  String                 @default("NORMAL")
  notes                     String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([studentProfileId])
  @@index([opportunityId])
  @@index([partnerOrganizationId])
  @@index([requestedById])
  @@index([assignedStaffId])
  @@index([status])
  @@index([priority])
  @@index([status, priority])
  @@index([createdAt])
}

model OutreachContact {
  id              String              @id @default(cuid())
  organizationId  String
  organization    PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String?
  email           String?
  phone           String?
  title           String?
  notes           String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  tasks           OutreachTask[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([organizationId])
  @@index([email])
  @@index([nextFollowUpAt])
}

model OutreachTask {
  id                    String               @id @default(cuid())
  contactId             String?
  partnerOrganizationId String?
  placementRequestId    String?
  assignedToId          String?
  createdById           String?
  contact               OutreachContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  partnerOrganization   PartnerOrganization? @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  placementRequest      PlacementRequest?    @relation(fields: [placementRequestId], references: [id], onDelete: SetNull)
  assignedTo            User?                @relation("OutreachTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy             User?                @relation("OutreachTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title                 String
  description           String?
  notes                 String?
  status                OutreachTaskStatus   @default(NOT_STARTED)
  priority              String               @default("NORMAL")
  dueAt                 DateTime?
  completedAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([contactId])
  @@index([partnerOrganizationId])
  @@index([placementRequestId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([status, dueAt])
  @@index([dueAt])
}

model Notification {
  id                String                  @id @default(cuid())
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              StudentNotificationType @default(GENERAL)
  title             String
  body              String?
  actionUrl         String?
  deduplicationKey  String?                 @unique
  opportunityId     String?
  opportunity       Opportunity?            @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  applicationId     String?
  application       Application?            @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  applicationTaskId String?
  applicationTask   ApplicationTask?        @relation(fields: [applicationTaskId], references: [id], onDelete: SetNull)
  readAt            DateTime?
  dismissedAt       DateTime?
  emailedAt         DateTime?
  createdAt         DateTime                @default(now())

  @@index([userId])
  @@index([userId, dismissedAt, createdAt])
  @@index([readAt])
  @@index([type, createdAt])
  @@index([opportunityId])
  @@index([applicationId])
  @@index([applicationTaskId])
  @@index([createdAt])
}

model StudentNotificationPreference {
  id                            String         @id @default(cuid())
  studentProfileId              String         @unique
  studentProfile                StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  inAppEnabled                  Boolean        @default(true)
  emailEnabled                  Boolean        @default(false)
  weeklyDigestEnabled           Boolean        @default(false)
  openingAlertsEnabled          Boolean        @default(true)
  deadlineAlertsEnabled         Boolean        @default(true)
  taskReminderEnabled           Boolean        @default(true)
  recommendationReminderEnabled Boolean        @default(true)
  interviewReminderEnabled      Boolean        @default(true)
  outcomeReminderEnabled        Boolean        @default(true)
  quietHoursStart               String?
  quietHoursEnd                 String?
  timezone                      String         @default("America/Chicago")
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt

  @@index([weeklyDigestEnabled])
}

model AdminNote {
  id                    String               @id @default(cuid())
  authorId              String?
  userId                String?
  studentProfileId      String?
  partnerOrganizationId String?
  opportunityId         String?
  author                User?                @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  user                  User?                @relation("AdminNoteUser", fields: [userId], references: [id], onDelete: SetNull)
  studentProfile        StudentProfile?      @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)
  partnerOrganization   PartnerOrganization? @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  opportunity           Opportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  body                  String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([authorId])
  @@index([userId])
  @@index([studentProfileId])
  @@index([partnerOrganizationId])
  @@index([opportunityId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Feedback {
  id           String             @id @default(cuid())
  authorId     String
  author       User               @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  feedbackType FeedbackType
  entityType   FeedbackEntityType
  entityId     String
  rating       Int
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([authorId, feedbackType, entityType, entityId])
  @@index([authorId])
  @@index([feedbackType])
  @@index([entityType, entityId])
  @@index([rating])
  @@index([createdAt])
}

model RecommendationEvent {
  id            String                  @id @default(cuid())
  userId        String?
  user          User?                   @relation("RecommendationEventUser", fields: [userId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity?            @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  applicationId String?
  application   Application?            @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  eventType     RecommendationEventType
  source        String
  matchScore    Int?
  searchQuery   String?
  resultCount   Int?
  metadata      Json?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([userId])
  @@index([opportunityId])
  @@index([applicationId])
  @@index([eventType])
  @@index([source])
  @@index([createdAt])
}

model DataQualityAcknowledgement {
  id               String   @id @default(cuid())
  entityType       String
  entityId         String
  issueKey         String
  acknowledgedById String
  acknowledgedBy   User     @relation("DataQualityAcknowledgementUser", fields: [acknowledgedById], references: [id], onDelete: Cascade)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([entityType, entityId, issueKey])
  @@index([acknowledgedById])
  @@index([entityType, entityId])
  @@index([issueKey])
  @@index([createdAt])
}

model EmbeddingRecord {
  id          String              @id @default(cuid())
  entityType  EmbeddingEntityType
  entityId    String
  embedding   Json
  contentHash String
  model       String
  dimensions  Int
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([entityId])
  @@index([contentHash])
  @@index([updatedAt])
}

model ActionRateLimit {
  id          String   @id @default(cuid())
  key         String
  action      String
  count       Int      @default(1)
  windowStart DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, action])
  @@index([action, expiresAt])
  @@index([expiresAt])
}
