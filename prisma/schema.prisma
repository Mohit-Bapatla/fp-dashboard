  NETWORKING
  FUNDRAISER
  OTHER
}

enum ProgramEventStatus {
  DRAFT
  PUBLISHED
  CANCELED
  COMPLETED
  ARCHIVED
}

enum EventRegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELED
  ATTENDED
