generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  PARTNER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum OpportunityType {
  INTERNSHIP
  SHADOWING
  RESEARCH
  VOLUNTEERING
  MENTORSHIP
  EVENT
  PROGRAM
}

enum OpportunityStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
  CLOSED
  REJECTED
}

enum ApplicationStatus {
  DRAFT
  SAVED
  PLANNING
  PREPARING
  WAITING_FOR_RECOMMENDATION
  READY_TO_SUBMIT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW
  WAITLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum OpportunityRelationshipType {
  EXTERNAL_PUBLIC
  FP_PARTNER
  FP_OWNED
}

enum OpportunityVerificationStatus {
  NEEDS_REVIEW
  VERIFIED
  STALE
  BROKEN_LINK
  REJECTED
  ARCHIVED
}

enum OpportunityAvailabilityStatus {
  OPEN
  OPENING_SOON
  ROLLING
  CLOSED
  EXPIRED
  ARCHIVED
}

enum OpportunityCorrectionCategory {
  BROKEN_LINK
  INCORRECT_DEADLINE
  ELIGIBILITY_ERROR
  PROGRAM_CLOSED
  DUPLICATE
  OTHER
}

enum OpportunityCorrectionStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum PlacementRequestStatus {
  NEW
  ASSIGNED
  RESEARCHING
  OUTREACH_IN_PROGRESS
  PARTNER_CONTACTED
  WAITING_FOR_PARTNER
  OPPORTUNITY_FOUND
  STUDENT_REFERRED
  PLACED
  CLOSED
}

enum OutreachTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  COMPLETED
  BLOCKED
}

enum PartnerStatus {
  NOT_CONTACTED
  CONTACTED
  FOLLOW_UP_NEEDED
  INTERESTED
  MEETING_SCHEDULED
  PARTNERED
  REJECTED
  NO_RESPONSE
  PAUSED
}

enum ResumeParseStatus {
  NOT_STARTED
  PROCESSING
  COMPLETED
  FAILED
}

enum ApplicationOnboardingItemStatus {
  NOT_STARTED
  SUBMITTED
  APPROVED
  NEEDS_CHANGES
  WAIVED
}

enum InterviewRequestStatus {
  REQUESTED
  STUDENT_RESPONDED
  SCHEDULED
  DECLINED
  CANCELED
  COMPLETED
}

enum ServiceHourVerificationStatus {
  PENDING
  VERIFIED
  CHANGES_REQUESTED
  REJECTED
}

enum CertificateStatus {
  NOT_REQUESTED
  PENDING_APPROVAL
  APPROVED
  ISSUED
  REVOKED
}

enum ProgramEventType {
  SEMINAR
  WORKSHOP
  PANEL
  VOLUNTEERING
  NETWORKING
  FUNDRAISER
  OTHER
}

enum ProgramEventStatus {
  DRAFT
  PUBLISHED
  CANCELED
  COMPLETED
  ARCHIVED
}

enum EventRegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELED
  ATTENDED
  NO_SHOW
}

enum SponsorStatus {
  PROSPECT
  CONTACTED
  IN_DISCUSSION
  COMMITTED
  ACTIVE
  DECLINED
  PAUSED
  PAST
}

enum SponsorshipCampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum SponsorshipCommitmentStatus {
  PLEDGED
  COMMITTED
  RECEIVED
  CANCELED
  DECLINED
}

enum SponsorDeliverableType {
  LOGO_PLACEMENT
  EVENT_MENTION
  NEWSLETTER_MENTION
  SOCIAL_POST
  THANK_YOU_EMAIL
  OTHER
}

enum SponsorDeliverableStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  WAIVED
}

enum SponsorInteractionType {
  NOTE
  EMAIL
  CALL
  MEETING
  FOLLOW_UP
}

enum RecordCommentEntityType {
  APPLICATION
  PLACEMENT_REQUEST
  OUTREACH_TASK
}

enum RecordCommentVisibility {
  INTERNAL
  PARTNER_VISIBLE
  STUDENT_VISIBLE
}

enum PartnerVerificationStatus {
  UNVERIFIED
  IN_REVIEW
  VERIFIED
  SUSPENDED
}

enum FeedbackType {
  STUDENT_APPLICATION_EXPERIENCE
  STUDENT_PLACEMENT_REQUEST
  PARTNER_APPLICANT_QUALITY
  PARTNER_REVIEW_USEFULNESS
  STAFF_MATCH_QUALITY
  STAFF_PLACEMENT_DIFFICULTY
}

enum FeedbackEntityType {
  APPLICATION
  OPPORTUNITY
  PLACEMENT_REQUEST
  USER
}

enum RecommendationEventType {
  IMPRESSION
  CLICK
  APPLICATION
  SEARCH_RESULTS
}

enum EmbeddingEntityType {
  OPPORTUNITY
  STUDENT_PROFILE
  RESUME
  PARTNER_ORGANIZATION
}

model User {
  id                                   String                        @id @default(cuid())
  clerkUserId                          String                        @unique
  email                                String                        @unique
  firstName                            String?
  lastName                             String?
  role                                 UserRole                      @default(STUDENT)
  studentProfile                       StudentProfile?
  partnerMemberships                   PartnerMember[]
  placementRequestsRequested           PlacementRequest[]            @relation("PlacementRequestRequester")
  placementRequestsAssigned            PlacementRequest[]            @relation("PlacementRequestAssignee")
  outreachTasksAssigned                OutreachTask[]                @relation("OutreachTaskAssignee")
  outreachTasksCreated                 OutreachTask[]                @relation("OutreachTaskCreator")
  notifications                        Notification[]
  adminNotesAuthored                   AdminNote[]                   @relation("AdminNoteAuthor")
  adminNotesAbout                      AdminNote[]                   @relation("AdminNoteUser")
  auditLogs                            AuditLog[]                    @relation("AuditLogActor")
  recordComments                       RecordComment[]               @relation("RecordCommentAuthor")
  onboardingItemsReviewed              ApplicationOnboardingItem[]   @relation("OnboardingItemReviewer")
  verifiedPartnerOrganizations         PartnerOrganization[]         @relation("PartnerVerifier")
  moderatedOpportunities               Opportunity[]                 @relation("OpportunityModerator")
  verifiedOpportunities                Opportunity[]                 @relation("OpportunityVerifier")
  opportunityCorrectionReports         OpportunityCorrectionReport[] @relation("OpportunityCorrectionReporter")
  reviewedOpportunityCorrectionReports OpportunityCorrectionReport[] @relation("OpportunityCorrectionReviewer")
  claimedStudentImportRecords          StudentImportRecord[]         @relation("StudentImportClaim")
  feedbackAuthored                     Feedback[]                    @relation("FeedbackAuthor")
  recommendationEvents                 RecommendationEvent[]         @relation("RecommendationEventUser")
  dataQualityAcknowledgements          DataQualityAcknowledgement[]  @relation("DataQualityAcknowledgementUser")
  interviewRequestsCreated             InterviewRequest[]            @relation("InterviewRequestCreator")
  interviewRequestsCanceled            InterviewRequest[]            @relation("InterviewRequestCanceler")
  serviceHoursVerified                 ServiceHourRecord[]           @relation("ServiceHourVerifier")
  certificatesApproved                 ServiceHourRecord[]           @relation("CertificateApprover")
  programEventsCreated                 ProgramEvent[]                @relation("ProgramEventCreator")
  eventRegistrationsCheckedIn          EventRegistration[]           @relation("EventRegistrationCheckIn")
  sponsorInteractionsAuthored          SponsorInteraction[]          @relation("SponsorInteractionAuthor")
  createdAt                            DateTime                      @default(now())
  updatedAt                            DateTime                      @updatedAt

  @@index([role])
  @@index([role, createdAt])
  @@index([createdAt])
}

model StudentProfile {
  id                    String              @id @default(cuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  school                String?
  gradeYear             String?
  major                 String?
  graduationYear        Int?
  city                  String?
  state                 String?
  country               String?
  locationPreference    String?
  remotePreference      String?
  ageYears              Int?
  maximumTravelMiles    Int?
  paidOnlyPreference    Boolean?
  preferredSeasons      String[]            @default([])
  certifications        String[]            @default([])
  transportationNotes   String?
  interestedSpecialties String[]            @default([])
  opportunityTypes      OpportunityType[]   @default([])
  availability          String[]            @default([])
  languages             String[]            @default([])
  careerGoals           String?
  experienceLevel       String?
  linkedinUrl           String?
  githubUrl             String?
  portfolioUrl          String?
  bio                   String?
  resumes               Resume[]
  applications          Application[]
  savedOpportunities    SavedOpportunity[]
  placementRequests     PlacementRequest[]
  adminNotes            AdminNote[]
  serviceHourRecords    ServiceHourRecord[]
  eventRegistrations    EventRegistration[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([graduationYear])
}

model StudentImportRecord {
  id                    String            @id @default(cuid())
  email                 String
  normalizedEmail       String            @unique
  firstName             String?
  lastName              String?
  school                String?
  gradeYear             String?
  major                 String?
  graduationYear        Int?
  city                  String?
  state                 String?
  country               String?
  locationPreference    String?
  remotePreference      String?
  interestedSpecialties String[]          @default([])
  opportunityTypes      OpportunityType[] @default([])
  availability          String[]          @default([])
  languages             String[]          @default([])
  careerGoals           String?
  experienceLevel       String?
  claimedAt             DateTime?
  claimedById           String?
  claimedBy             User?             @relation("StudentImportClaim", fields: [claimedById], references: [id], onDelete: SetNull)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([email])
  @@index([claimedAt])
  @@index([claimedById])
}

model Resume {
  id                      String            @id @default(cuid())
  studentProfileId        String
  studentProfile          StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  fileName                String
  fileUrl                 String?
  parseStatus             ResumeParseStatus @default(NOT_STARTED)
  parsedText              String?
  parsedSummary           String?
  extractedSkills         String[]          @default([])
  extractedEducation      String[]          @default([])
  extractedExperience     String[]          @default([])
  extractedCertifications String[]          @default([])
  applications            Application[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([studentProfileId])
  @@index([parseStatus])
}

model PartnerOrganization {
  id                    String                    @id @default(cuid())
  name                  String                    @unique
  status                PartnerStatus             @default(NOT_CONTACTED)
  website               String?
  type                  String?
  description           String?
  location              String?
  city                  String?
  state                 String?
  country               String?
  healthcareFocus       String?
  specialtyAreas        String[]                  @default([])
  contactEmail          String?
  lastContactedAt       DateTime?
  nextFollowUpAt        DateTime?
  verificationStatus    PartnerVerificationStatus @default(UNVERIFIED)
  verificationChecklist String[]                  @default([])
  verificationNotes     String?
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?                     @relation("PartnerVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  members               PartnerMember[]
  opportunities         Opportunity[]
  placementRequests     PlacementRequest[]
  outreachContacts      OutreachContact[]
  outreachTasks         OutreachTask[]
  adminNotes            AdminNote[]
  serviceHourRecords    ServiceHourRecord[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([status])
  @@index([status, createdAt])
  @@index([verificationStatus])
  @@index([nextFollowUpAt])
  @@index([createdAt])
}

model PartnerMember {
  id             String              @id @default(cuid())
  userId         String
  organizationId String
  title          String?
  isPrimary      Boolean             @default(false)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Opportunity {
  id                          String                        @id @default(cuid())
  organizationId              String
  organization                PartnerOrganization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title                       String
  description                 String?
  shortDescription            String?
  fpSummary                   String?
  type                        OpportunityType
  specialty                   String?
  status                      OpportunityStatus             @default(DRAFT)
  relationshipType            OpportunityRelationshipType   @default(EXTERNAL_PUBLIC)
  officialSourceUrl           String?
  officialApplicationUrl      String?
  relationshipNotes           String?
  verificationStatus          OpportunityVerificationStatus @default(NEEDS_REVIEW)
  lastVerifiedAt              DateTime?
  nextVerificationAt          DateTime?
  verifiedById                String?
  verifiedBy                  User?                         @relation("OpportunityVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationNotes           String?
  brokenLinkDetectedAt        DateTime?
  archivalReason              String?
  availabilityStatus          OpportunityAvailabilityStatus @default(OPEN)
  opensAt                     DateTime?
  isRolling                   Boolean                       @default(false)
  cycleLabel                  String?
  location                    String?
  remoteType                  String?
  address                     String?
  city                        String?
  state                       String?
  country                     String?
  postalCode                  String?
  geographicScope             String?
  transportationNotes         String?
  maximumTravelMiles          Int?
  paidStatus                  String?
  deadline                    DateTime?
  capacity                    Int?
  eligibilityRequirements     String?
  minimumAge                  Int?
  maximumAge                  Int?
  acceptedGradeLevels         String[]                      @default([])
  minimumGpa                  Float?
  residencyRequirement        String?
  citizenshipRequirement      String?
  requiredExperience          String?
  requiredCertifications      String[]                      @default([])
  parentPermissionRequired    Boolean?
  workAuthorizationRequired   Boolean?
  eligibilityUnknowns         String[]                      @default([])
  requiredDocuments           String[]                      @default([])
  applicationInstructions     String?
  estimatedApplicationMinutes Int?
  essayQuestionCount          Int?
  scheduleRequirements        String?
  estimatedWeeklyHours        Float?
  startsAt                    DateTime?
  endsAt                      DateTime?
  publishedAt                 DateTime?
  moderationFlags             String[]                      @default([])
  moderationNotes             String?
  moderatedAt                 DateTime?
  moderatedById               String?
  moderatedBy                 User?                         @relation("OpportunityModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  applications                Application[]
  savedByStudents             SavedOpportunity[]
  correctionReports           OpportunityCorrectionReport[]
  placementRequests           PlacementRequest[]
  adminNotes                  AdminNote[]
  recommendationEvents        RecommendationEvent[]
  serviceHourRecords          ServiceHourRecord[]
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([status, deadline])
  @@index([organizationId, status, createdAt])
  @@index([moderatedById])
  @@index([verifiedById])
  @@index([verificationStatus])
  @@index([availabilityStatus])
  @@index([relationshipType])
  @@index([nextVerificationAt])
  @@index([deadline])
  @@index([officialSourceUrl])
  @@index([organizationId, title])
  @@index([createdAt])
}

model Application {
  id                     String                      @id @default(cuid())
  studentProfileId       String
  opportunityId          String
  resumeId               String?
  studentProfile         StudentProfile              @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  opportunity            Opportunity                 @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  resume                 Resume?                     @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  status                 ApplicationStatus           @default(DRAFT)
  statement              String?
  submittedAt            DateTime?
  targetDeadline         DateTime?
  completionPercent      Int                         @default(0)
  nextAction             String?
  privateNotes           String?
  submissionConfirmation String?
  outcomeNotes           String?
  lastActivityAt         DateTime                    @default(now())
  reviewedAt             DateTime?
  onboardingItems        ApplicationOnboardingItem[]
  checklistItems         ApplicationChecklistItem[]
  recommendationEvents   RecommendationEvent[]
  interviewRequests      InterviewRequest[]
  serviceHourRecords     ServiceHourRecord[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@unique([studentProfileId, opportunityId])
  @@index([resumeId])
  @@index([status])
  @@index([status, submittedAt])
  @@index([opportunityId, status, submittedAt])
  @@index([createdAt])
}

model SavedOpportunity {
  id               String         @id @default(cuid())
  studentProfileId String
  opportunityId    String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  opportunity      Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  followReopening  Boolean        @default(false)
  dismissedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentProfileId, opportunityId])
  @@index([opportunityId])
  @@index([studentProfileId, updatedAt])
}

model ApplicationChecklistItem {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  label         String
  description   String?
  required      Boolean     @default(true)
  completedAt   DateTime?
  source        String?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([applicationId, label])
  @@index([applicationId, sortOrder])
}

model OpportunityCorrectionReport {
  id              String                        @id @default(cuid())
  opportunityId   String
  opportunity     Opportunity                   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  reporterId      String
  reporter        User                          @relation("OpportunityCorrectionReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  category        OpportunityCorrectionCategory
  details         String?
  sourceUrl       String?
  status          OpportunityCorrectionStatus   @default(OPEN)
  reviewedById    String?
  reviewedBy      User?                         @relation("OpportunityCorrectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@index([opportunityId, status])
  @@index([reporterId])
  @@index([reviewedById])
  @@index([status, createdAt])
}

model ApplicationOnboardingItem {
  id            String                          @id @default(cuid())
  applicationId String
  application   Application                     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        ApplicationOnboardingItemStatus @default(NOT_STARTED)
  required      Boolean                         @default(true)
  studentNotes  String?
  reviewerNotes String?
  dueAt         DateTime?
  submittedAt   DateTime?
  completedAt   DateTime?
  reviewedAt    DateTime?
  reviewerId    String?
  reviewer      User?                           @relation("OnboardingItemReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  @@unique([applicationId, title])
  @@index([applicationId])
  @@index([status])
  @@index([reviewerId])
}

model InterviewRequest {
  id                   String                  @id @default(cuid())
  applicationId        String
  application          Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status               InterviewRequestStatus  @default(REQUESTED)
  meetingLink          String?
  location             String?
  notes                String?
  studentResponseNotes String?
  selectedSlotId       String?
  selectedSlot         ProposedInterviewSlot?  @relation("SelectedInterviewSlot", fields: [selectedSlotId], references: [id], onDelete: SetNull)
  createdById          String?
  createdBy            User?                   @relation("InterviewRequestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  canceledById         String?
  canceledBy           User?                   @relation("InterviewRequestCanceler", fields: [canceledById], references: [id], onDelete: SetNull)
  respondedAt          DateTime?
  scheduledAt          DateTime?
  canceledAt           DateTime?
  completedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  proposedSlots        ProposedInterviewSlot[] @relation("InterviewRequestSlots")

  @@index([applicationId])
  @@index([status])
  @@index([selectedSlotId])
  @@index([createdById])
  @@index([canceledById])
  @@index([createdAt])
}

model ProposedInterviewSlot {
  id                 String             @id @default(cuid())
  interviewRequestId String
  interviewRequest   InterviewRequest   @relation("InterviewRequestSlots", fields: [interviewRequestId], references: [id], onDelete: Cascade)
  selectedFor        InterviewRequest[] @relation("SelectedInterviewSlot")
  startsAt           DateTime
  endsAt             DateTime
  selected           Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([interviewRequestId])
  @@index([startsAt])
  @@index([selected])
}

model RecordComment {
  id         String                  @id @default(cuid())
  entityType RecordCommentEntityType
  entityId   String
  authorId   String?
  author     User?                   @relation("RecordCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  visibility RecordCommentVisibility @default(INTERNAL)
  body       String
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([authorId])
  @@index([entityType, entityId])
  @@index([visibility])
  @@index([createdAt])
}

model ServiceHourRecord {
  id                    String                        @id @default(cuid())
  applicationId         String
  application           Application                   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  studentProfileId      String
  studentProfile        StudentProfile                @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  opportunityId         String
  opportunity           Opportunity                   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  partnerOrganizationId String
  partnerOrganization   PartnerOrganization           @relation(fields: [partnerOrganizationId], references: [id], onDelete: Cascade)
  hours                 Float
  description           String?
  verificationStatus    ServiceHourVerificationStatus @default(PENDING)
  verifiedById          String?
  verifiedBy            User?                         @relation("ServiceHourVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt            DateTime?
  verificationNotes     String?
  certificateStatus     CertificateStatus             @default(NOT_REQUESTED)
  approvedById          String?
  approvedBy            User?                         @relation("CertificateApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  certificateNotes      String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  @@index([applicationId])
  @@index([studentProfileId])
  @@index([opportunityId])
  @@index([partnerOrganizationId])
  @@index([verificationStatus])
  @@index([certificateStatus])
  @@index([verifiedById])
  @@index([approvedById])
  @@index([createdAt])
}

model ProgramEvent {
  id                   String              @id @default(cuid())
  title                String
  description          String?
  eventType            ProgramEventType    @default(OTHER)
  startAt              DateTime
  endAt                DateTime?
  location             String?
  virtualLink          String?
  capacity             Int?
  registrationDeadline DateTime?
  status               ProgramEventStatus  @default(DRAFT)
  speakerNames         String[]            @default([])
  createdById          String?
  createdBy            User?               @relation("ProgramEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  registrations        EventRegistration[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status])
  @@index([eventType])
  @@index([startAt])
  @@index([registrationDeadline])
  @@index([createdById])
}

model EventRegistration {
  id                String                  @id @default(cuid())
  eventId           String
  event             ProgramEvent            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentProfileId  String
  studentProfile    StudentProfile          @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  status            EventRegistrationStatus @default(REGISTERED)
  attendedAt        DateTime?
  checkedInById     String?
  checkedInBy       User?                   @relation("EventRegistrationCheckIn", fields: [checkedInById], references: [id], onDelete: SetNull)
  certificateStatus CertificateStatus       @default(NOT_REQUESTED)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([eventId, studentProfileId])
  @@index([eventId])
  @@index([studentProfileId])
  @@index([status])
  @@index([checkedInById])
  @@index([createdAt])
}

model SponsorOrganization {
  id           String                  @id @default(cuid())
  name         String                  @unique
  status       SponsorStatus           @default(PROSPECT)
  website      String?
  description  String?
  location     String?
  contactEmail String?
  donationUrl  String?
  contacts     SponsorContact[]
  commitments  SponsorshipCommitment[]
  interactions SponsorInteraction[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([status])
  @@index([contactEmail])
  @@index([createdAt])
}

model SponsorContact {
  id                    String               @id @default(cuid())
  sponsorOrganizationId String
  sponsorOrganization   SponsorOrganization  @relation(fields: [sponsorOrganizationId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String?
  email                 String?
  phone                 String?
  title                 String?
  notes                 String?
  lastContactedAt       DateTime?
  nextFollowUpAt        DateTime?
  interactions          SponsorInteraction[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([sponsorOrganizationId])
  @@index([email])
  @@index([nextFollowUpAt])
}

model SponsorshipCampaign {
  id              String                    @id @default(cuid())
  name            String
  description     String?
  goalAmountCents Int?
  startAt         DateTime?
  endAt           DateTime?
  status          SponsorshipCampaignStatus @default(DRAFT)
  commitments     SponsorshipCommitment[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([createdAt])
}

model SponsorshipCommitment {
  id                    String                      @id @default(cuid())
  sponsorOrganizationId String
  sponsorOrganization   SponsorOrganization         @relation(fields: [sponsorOrganizationId], references: [id], onDelete: Cascade)
  campaignId            String?
  campaign              SponsorshipCampaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  amountCents           Int?
  status                SponsorshipCommitmentStatus @default(PLEDGED)
  committedAt           DateTime?
  receivedAt            DateTime?
  notes                 String?
  deliverables          SponsorDeliverable[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([sponsorOrganizationId])
  @@index([campaignId])
  @@index([status])
  @@index([committedAt])
  @@index([receivedAt])
}

model SponsorDeliverable {
  id           String                   @id @default(cuid())
  commitmentId String
  commitment   SponsorshipCommitment    @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  type         SponsorDeliverableType
  status       SponsorDeliverableStatus @default(TODO)
  dueAt        DateTime?
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([commitmentId])
  @@index([type])
  @@index([status])
  @@index([dueAt])
}

model SponsorInteraction {
  id                    String                 @id @default(cuid())
  sponsorOrganizationId String
  sponsorOrganization   SponsorOrganization    @relation(fields: [sponsorOrganizationId], references: [id], onDelete: Cascade)
  contactId             String?
  contact               SponsorContact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  authorId              String?
  author                User?                  @relation("SponsorInteractionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  type                  SponsorInteractionType @default(NOTE)
  body                  String
  occurredAt            DateTime               @default(now())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([sponsorOrganizationId])
  @@index([contactId])
  @@index([authorId])
  @@index([type])
  @@index([occurredAt])
}

model PlacementRequest {
  id                        String                 @id @default(cuid())
  studentProfileId          String
  opportunityId             String?
  partnerOrganizationId     String?
  requestedById             String?
  assignedStaffId           String?
  studentProfile            StudentProfile         @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  opportunity               Opportunity?           @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  partnerOrganization       PartnerOrganization?   @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  requestedBy               User?                  @relation("PlacementRequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  assignedStaff             User?                  @relation("PlacementRequestAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  outreachTasks             OutreachTask[]
  status                    PlacementRequestStatus @default(NEW)
  title                     String
  description               String?
  requestedSpecialties      String[]               @default([])
  requestedOpportunityTypes OpportunityType[]      @default([])
  locationPreference        String?
  remotePreference          String?
  availability              String[]               @default([])
  urgency                   String?
  priority                  String                 @default("NORMAL")
  notes                     String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([studentProfileId])
  @@index([opportunityId])
  @@index([partnerOrganizationId])
  @@index([requestedById])
  @@index([assignedStaffId])
  @@index([status])
  @@index([priority])
  @@index([status, priority])
  @@index([createdAt])
}

model OutreachContact {
  id              String              @id @default(cuid())
  organizationId  String
  organization    PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String?
  email           String?
  phone           String?
  title           String?
  notes           String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  tasks           OutreachTask[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([organizationId])
  @@index([email])
  @@index([nextFollowUpAt])
}

model OutreachTask {
  id                    String               @id @default(cuid())
  contactId             String?
  partnerOrganizationId String?
  placementRequestId    String?
  assignedToId          String?
  createdById           String?
  contact               OutreachContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  partnerOrganization   PartnerOrganization? @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  placementRequest      PlacementRequest?    @relation(fields: [placementRequestId], references: [id], onDelete: SetNull)
  assignedTo            User?                @relation("OutreachTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy             User?                @relation("OutreachTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title                 String
  description           String?
  notes                 String?
  status                OutreachTaskStatus   @default(NOT_STARTED)
  priority              String               @default("NORMAL")
  dueAt                 DateTime?
  completedAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([contactId])
  @@index([partnerOrganizationId])
  @@index([placementRequestId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([status, dueAt])
  @@index([dueAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model AdminNote {
  id                    String               @id @default(cuid())
  authorId              String?
  userId                String?
  studentProfileId      String?
  partnerOrganizationId String?
  opportunityId         String?
  author                User?                @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  user                  User?                @relation("AdminNoteUser", fields: [userId], references: [id], onDelete: SetNull)
  studentProfile        StudentProfile?      @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)
  partnerOrganization   PartnerOrganization? @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  opportunity           Opportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  body                  String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([authorId])
  @@index([userId])
  @@index([studentProfileId])
  @@index([partnerOrganizationId])
  @@index([opportunityId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Feedback {
  id           String             @id @default(cuid())
  authorId     String
  author       User               @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  feedbackType FeedbackType
  entityType   FeedbackEntityType
  entityId     String
  rating       Int
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([authorId, feedbackType, entityType, entityId])
  @@index([authorId])
  @@index([feedbackType])
  @@index([entityType, entityId])
  @@index([rating])
  @@index([createdAt])
}

model RecommendationEvent {
  id            String                  @id @default(cuid())
  userId        String?
  user          User?                   @relation("RecommendationEventUser", fields: [userId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity?            @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  applicationId String?
  application   Application?            @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  eventType     RecommendationEventType
  source        String
  matchScore    Int?
  searchQuery   String?
  resultCount   Int?
  metadata      Json?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([userId])
  @@index([opportunityId])
  @@index([applicationId])
  @@index([eventType])
  @@index([source])
  @@index([createdAt])
}

model DataQualityAcknowledgement {
  id               String   @id @default(cuid())
  entityType       String
  entityId         String
  issueKey         String
  acknowledgedById String
  acknowledgedBy   User     @relation("DataQualityAcknowledgementUser", fields: [acknowledgedById], references: [id], onDelete: Cascade)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([entityType, entityId, issueKey])
  @@index([acknowledgedById])
  @@index([entityType, entityId])
  @@index([issueKey])
  @@index([createdAt])
}

model EmbeddingRecord {
  id          String              @id @default(cuid())
  entityType  EmbeddingEntityType
  entityId    String
  embedding   Json
  contentHash String
  model       String
  dimensions  Int
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([entityId])
  @@index([contentHash])
  @@index([updatedAt])
}

model ActionRateLimit {
  id          String   @id @default(cuid())
  key         String
  action      String
  count       Int      @default(1)
  windowStart DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, action])
  @@index([action, expiresAt])
  @@index([expiresAt])
}
