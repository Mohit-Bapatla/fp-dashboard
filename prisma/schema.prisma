  SUBMIT_INTERNAL_APPLICATION
  CONFIRM_EXTERNAL_SUBMISSION
  SCHEDULE_INTERVIEW
  PREPARE_FOR_INTERVIEW
  SEND_FOLLOW_UP
  REPORT_OUTCOME
  CUSTOM
}

enum ApplicationTaskStatus {
